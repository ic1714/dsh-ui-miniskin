{
  "name": "dsh-ui-miniskin",
  "version": "1.1.0",
  "private": false,
  "description": "DSH 界面美化：启动动画 + 界面壁纸。设置集成在 DSH 自带设置面板的「界面美化」一节里",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "assets",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "ic1714",
  "repository": {
    "type": "git",
    "url": "https://github.com/ic1714/dsh-ui-miniskin.git"
  },
  "license": "MIT"
}
